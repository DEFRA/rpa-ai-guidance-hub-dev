# Copy to .env before `docker compose up`. Every value below has a working
# default in the compose files, so .env is optional for a plain local run.
#
# Values here are HOST-oriented (localhost endpoints), for running a service
# directly on the host against dockerised dependencies. The compose files
# hard-set the container-oriented equivalents over the top.

# UI session. hapi's cookie auth refuses to start without a password of 32+
# characters -- the UI crashes with "session.cookie.password: must be of type
# String". Generate one with: openssl rand -base64 32
SESSION_COOKIE_PASSWORD=

# UI auth. Defaults to `entra`, which needs a real tenant; `local` gives a
# development login. With `entra`, also set ENTRA_TENANT_ID, ENTRA_CLIENT_ID,
# ENTRA_CLIENT_SECRET and ENTRA_REDIRECT_HOST=http://localhost:3000.
AUTH_PROVIDER=local

# AWS Configuration
AWS_REGION=eu-west-2
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# AWS EMF Configuration (for python services)
AWS_EMF_ENVIRONMENT=local
AWS_EMF_AGENT_ENDPOINT=tcp://127.0.0.1:25888
AWS_EMF_LOG_GROUP_NAME=log-group-name
AWS_EMF_LOG_STREAM_NAME=log-stream-name
AWS_EMF_NAMESPACE=namespace
AWS_EMF_SERVICE_NAME=service-name
AWS_EMF_SERVICE_TYPE=python-backend-service

FLOCI_ENDPOINT_URL=http://localhost:4566

# cdp-uploader. The compose files hard-set the container-oriented base URL
# (http://cdp-uploader:7337) over the top of this host-oriented one.
CDP_UPLOADER_BASE_URL=http://localhost:7337
CDP_UPLOADER_BROWSER_URL=http://localhost:7337
SOURCE_DOCS_S3_BUCKET=rpa-ai-guidance-hub-source-docs

# Bedrock. Replace with a real inference profile ARN to exercise the LLM;
# AppConfig refuses to start if CLAUDE_SONNET_MODEL_CONFIG is unset.
AWS_BEARER_TOKEN_BEDROCK=dummy_token_for_bedrock
CLAUDE_SONNET_MODEL_CONFIG=anthropic.claude-sonnet-4-6,arn:aws:bedrock:eu-west-2:123456789012:application-inference-profile/fake-profile-local
